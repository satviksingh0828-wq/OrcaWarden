# Private Render server variables. Do not prefix these with VITE_ or expose them in the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_OTS_BUCKET=orcawarden-ots
# Set once and keep unchanged for the lifetime of the deployment. Minimum 8 characters.
ORCAWARDEN_ENCRYPTION_KEY=replace-with-a-permanent-strong-server-key
# Generate a random Base32 secret (for example: `openssl rand -hex 20` then Base32-encode it).
# Add this key manually to Google Authenticator, 1Password, or another TOTP app as OrcaWarden.
ORCAWARDEN_TOTP_SECRET=REPLACE_WITH_BASE32_TOTP_SECRET
# Generate with: openssl rand -hex 32. Keep this stable; it signs private app sessions.
ORCAWARDEN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
