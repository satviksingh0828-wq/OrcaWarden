# Supabase project settings. The anon key is safe for browser use when Storage policies are configured.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_OTS_BUCKET=orcawarden-ots
# Set once and keep unchanged for the lifetime of this deployment. Minimum 8 characters.
VITE_ORCAWARDEN_ENCRYPTION_KEY=replace-with-a-permanent-strong-key
